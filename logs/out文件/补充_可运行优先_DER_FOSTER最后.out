import json,sys,os
cfg,seed=sys.argv[1],int(sys.argv[2]); d=json.load(open(cfg)); b=d['backbone_type']; b=b[11:] if b.startswith('pretrained_') else b; init=0 if d['init_cls']==d['increment'] else d['init_cls']; p=f"logs/第二轮A800/{d['model_name']}/{d['dataset']}_{b}_{init}_{d['increment']}_{seed}.log"
